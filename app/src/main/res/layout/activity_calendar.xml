<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".CalendarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header with curved bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/header_curved_background"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/events"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRoleInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FBLA Chapter Events"
                    android:textColor="@color/fbla_gold"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Selected Date Display -->
            <TextView
                android:id="@+id/textSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Events"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="@drawable/date_badge_background"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp" />

        </LinearLayout>

        <!-- Custom Calendar with event dots -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/navy"
            app:strokeWidth="3dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Month Navigation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_chevron_left"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous month"
                        app:tint="@color/navy" />

                    <TextView
                        android:id="@+id/textMonthYear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="March 2026"
                        android:textColor="@color/navy"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_chevron_right"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next month"
                        app:tint="@color/navy" />

                </LinearLayout>

                <!-- Day of Week Headers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sun"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Mon"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tue"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Wed"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Thu"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Fri"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sat"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Calendar Day Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Upcoming Events Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textEventsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upcoming Events"
                android:textColor="@color/navy"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textShowAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show All"
                android:textColor="@color/cobalt"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:alpha="0.3"
                android:contentDescription="No events" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_events"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/textEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Officers can add events using the + button"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Events RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_nav_background"
            android:elevation="8dp"
            app:itemIconTint="@drawable/nav_item_color"
            app:itemTextColor="@drawable/nav_item_color"
            app:itemRippleColor="@color/nav_ripple_color"
            app:menu="@menu/bottom_navigation"
            app:labelVisibilityMode="labeled" />

    </LinearLayout>

    <!-- Add Event FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:backgroundTint="@color/fbla_gold"
        app:tint="@color/navy"
        android:contentDescription="Add Event" />

    <!-- Dim overlay for inline event form -->
    <FrameLayout
        android:id="@+id/overlayDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Inline Add Event Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/inlineEventPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar: X close and Save -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnClosePanel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    app:tint="@color/white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnSaveInline"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Save"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/fbla_gold"
                    android:textColor="@color/navy"
                    style="@style/Widget.Material3.Button" />

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <!-- Title input -->
                    <EditText
                        android:id="@+id/editInlineTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Add title and time"
                        android:textColorHint="#80FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:inputType="textCapSentences"
                        android:background="@null"
                        android:paddingVertical="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#40FFFFFF" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- Date & Time row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Time" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/textInlineStartDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select Date"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:padding="6dp"
                                    android:background="?attr/selectableItemBackground" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" – "
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/textInlineEndDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select Date"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:padding="6dp"
                                    android:background="?attr/selectableItemBackground" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Does not repeat"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:paddingStart="6dp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnInlineAddTime"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Add time"
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/bg_chip_unselected" />

                    </LinearLayout>

                    <!-- Time row -->
                    <LinearLayout
                        android:id="@+id/layoutInlineTimeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:paddingStart="36dp">

                        <TextView
                            android:id="@+id/textInlineStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start time"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:padding="6dp"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" – "
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textInlineEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End time"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:padding="6dp"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#15FFFFFF"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:layout_marginTop="10dp"
                            android:contentDescription="Description" />

                        <EditText
                            android:id="@+id/editInlineDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add description"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="1"
                            android:gravity="top"
                            android:background="@null"
                            android:paddingVertical="10dp" />

                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Location" />

                        <EditText
                            android:id="@+id/editInlineLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add location"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:inputType="text"
                            android:background="@null"
                            android:paddingVertical="10dp" />

                    </LinearLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/textInlineError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF6B6B"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
