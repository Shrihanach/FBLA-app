<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    tools:context=".AddEditEventActivity">

    <!-- Floating card in the center -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar: X close and Save -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    app:tint="@color/white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Hidden title for edit mode reference -->
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Save"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/fbla_gold"
                    android:textColor="@color/navy"
                    style="@style/Widget.Material3.Button" />

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <!-- Title input - underline style -->
                    <EditText
                        android:id="@+id/editTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Add title and time"
                        android:textColorHint="#80FFFFFF"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:inputType="textCapSentences"
                        android:background="@null"
                        android:paddingVertical="10dp" />

                    <!-- Underline -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#40FFFFFF" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- Date & Time row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <!-- Clock icon -->
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Time" />

                        <!-- Date display -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/textStartDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select Date"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:padding="6dp"
                                    android:background="?attr/selectableItemBackground" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" – "
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/textEndDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select Date"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:padding="6dp"
                                    android:background="?attr/selectableItemBackground" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textRepeat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Does not repeat"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:paddingStart="6dp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <!-- Add time button -->
                        <TextView
                            android:id="@+id/btnAddTime"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Add time"
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:background="@drawable/bg_chip_unselected" />

                    </LinearLayout>

                    <!-- Time row (hidden by default, shown when "Add time" is tapped) -->
                    <LinearLayout
                        android:id="@+id/layoutTimeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:paddingStart="36dp">

                        <TextView
                            android:id="@+id/textStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start time"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:padding="6dp"
                            android:background="?attr/selectableItemBackground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" – "
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End time"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:padding="6dp"
                            android:background="?attr/selectableItemBackground" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#15FFFFFF"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Description -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:layout_marginTop="10dp"
                            android:contentDescription="Description" />

                        <EditText
                            android:id="@+id/editDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add description"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="1"
                            android:gravity="top"
                            android:background="@null"
                            android:paddingVertical="10dp" />

                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#B3FFFFFF"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Location" />

                        <EditText
                            android:id="@+id/editLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Add location"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:inputType="text"
                            android:background="@null"
                            android:paddingVertical="10dp" />

                    </LinearLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FF6B6B"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
