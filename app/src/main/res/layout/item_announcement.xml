<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <!-- Frosted glass announcement card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_frosted_navy"
        android:padding="20dp">

        <!-- ===== TOP ROW: Gold bar + Title + Action Buttons ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Vertical gold accent bar -->
            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="@color/fbla_gold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="Announcement Title" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Announcement"
                android:visibility="gone"
                app:tint="@color/fbla_gold" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Announcement"
                android:visibility="gone"
                app:tint="#FF8A80" />

        </LinearLayout>

        <!-- ===== AUTHOR ROW ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fbla_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Posted by Officer Name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:text="2 hours ago" />

        </LinearLayout>

        <!-- ===== GLASS DIVIDER (subtle white line) ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#18FFFFFF"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- ===== CONTENT (HTML-rendered) ===== -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:text="Announcement content goes here..." />

        <!-- ===== ATTACHMENTS CONTAINER ===== -->
        <LinearLayout
            android:id="@+id/layoutAttachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- ===== POLL CONTAINER ===== -->
        <LinearLayout
            android:id="@+id/layoutPoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textPollQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fbla_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawablePadding="6dp" />

            <LinearLayout
                android:id="@+id/layoutPollOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
