<?xml version="1.0" encoding="utf-8"?>
<!-- REPLACE THIS FILE with the actual FBLA "Make Your Mark" banner image:
     Save the image as fbla_banner_bg.jpg or fbla_banner_bg.png
     and delete this .xml file. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base navy layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#050C1E"
                android:centerColor="#0A1845"
                android:endColor="#0047AB"
                android:angle="160"
                android:type="linear" />
        </shape>
    </item>
    <!-- Gold accent overlay (subtle) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:centerColor="#15C5A900"
                android:endColor="#00000000"
                android:angle="45"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
